# App Settings
APP_NAME=Bitcoin-Invoice-Flow
ENV=development
DEBUG=true

# Exchange API (optional, z.B. Kraken)
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# BTCPay Server Integration (optional, Webhook: POST /webhook/btcpay)
BTCPAY_SERVER_URL=https://mainnet.demo.btcpayserver.org
BTCPAY_API_KEY=your_btcpay_api_key
# BTCPAY_WEBHOOK_SECRET=secret_aus_btcpay_webhook_einstellungen

# Database
DATABASE_URL=sqlite:///./sql_app.db

